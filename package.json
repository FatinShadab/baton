{
  "name": "baton",
  "displayName": "Baton",
  "description": "Route coding tasks from your VS Code sidebar.",
  "version": "0.0.1",
  "publisher": "baton-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:baton.panel",
    "onCommand:baton.copyMcpConfig"
  ],
  "contributes": {
    "commands": [
      {
        "command": "baton.setKeys",
        "title": "Baton: Set API Keys"
      },
      {
        "command": "baton.focus",
        "title": "Baton: Focus"
      },
      {
        "command": "baton.demo",
        "title": "Baton: Load Demo Task"
      },
      {
        "command": "baton.copyMcpConfig",
        "title": "Baton: Copy MCP Config"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "baton",
          "title": "Baton",
          "icon": "media/baton.svg"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "baton.local-context",
        "label": "Baton local context"
      }
    ],
    "views": {
      "baton": [
        {
          "type": "webview",
          "id": "baton.panel",
          "name": "Baton"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "eval": "esbuild scripts/eval.ts --bundle --platform=node --target=node18 --outfile=dist/eval.cjs && node dist/eval.cjs"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@google/genai": "1.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "minisearch": "^7.2.0",
    "zod": "^3.25.76"
  }
}
